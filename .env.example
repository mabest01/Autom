HELLOWORK_EMAIL=your_email@example.com
HELLOWORK_PASSWORD=your_password
ANTHROPIC_API_KEY=your_anthropic_key
SEARCH_KEYWORDS=alternance data,alternance développeur,alternance informatique
SEARCH_LOCATION=Île-de-France
SCRAPE_INTERVAL_HOURS=6
AUTO_APPLY=true

# Optional: e-mail alerts on 3 consecutive login failures
# Leave blank to disable (alerts are always written to logs/app.log)
EMAIL_ALERT=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_app_password
